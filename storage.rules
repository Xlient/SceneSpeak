rules_version = '2';

// Shared cache of AI-painted backdrops. Learner recordings and photos are never stored.
service firebase.storage {
  match /b/{bucket}/o {

    // backdrops/{sha256}.{jpg|png|webp}: one painted backdrop per scene, written once, read by everyone.
    match /backdrops/{file} {
      allow read: if request.auth != null;

      // `resource == null`: an upload over an existing file counts as a create, so check it's new.
      allow create: if request.auth != null
        && resource == null
        && file.matches('^[0-9a-f]{64}[.](jpg|png|webp)$')
        && request.resource.size > 0
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      // Written once: nobody can replace or remove a cached backdrop from the app.
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
