{
  "name": "scenespeak",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev": "pnpm --filter @scenespeak/web dev",
    "mobile": "pnpm --filter @scenespeak/mobile start",
    "build": "pnpm --filter @scenespeak/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-scenespeak \"vitest run --config vitest.rules.config.ts\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.36.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
